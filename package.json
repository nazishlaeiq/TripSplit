{
  "name": "tripsplit-desktop",
  "version": "1.0.0",
  "description": "TripSplit desktop app for Windows",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.tripsplit.desktop",
    "productName": "TripSplit",
    "files": [
      "main.js",
      "app/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "portable"
      ],
      "artifactName": "TripSplit.exe"
    }
  }
}
